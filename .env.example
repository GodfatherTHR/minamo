# Telegram
TELEGRAM_BOT_TOKEN=123456:ABC-your-token-here
# Leave empty to bind the first chat that sends /start.
# Set it to lock the bot to a single chat id (see /id in the bot).
OWNER_CHAT_ID=

# Ollama
OLLAMA_URL=http://127.0.0.1:11434
# Chat model. Any model Ollama can serve; cloud models are named like beam:cloud.
OLLAMA_MODEL=qwen3:8b
# Context window. Smaller = less RAM. This box has ~15 GB total.
OLLAMA_NUM_CTX=8192
# Hard cap on generated tokens (thinking + answer) for normal chat.
OLLAMA_NUM_PREDICT=900
# Seconds a request may take before being written off.
OLLAMA_TIMEOUT=600
# -1 keeps the model resident in RAM (fast replies, needs the RAM).
OLLAMA_KEEP_ALIVE=-1
# Leave blank to use the model's own defaults.
OLLAMA_TEMPERATURE=

# Chat behaviour
HISTORY_MESSAGES=16
HISTORY_CHARS=12000
MAX_INPUT_CHARS=8000
# Minimum seconds between two edits of the same Telegram message.
EDIT_INTERVAL=1.3
STATS_FOOTER=1
DEBUG=0

# Remote build (shell, files, agent)
# Everything the bot touches must live under this directory.
WORKSPACE_ROOT=/home/you
# Timeout for a command run inline with !cmd.
SHELL_TIMEOUT=60
# 0 = pi's risky tool calls need a tap in Telegram. 1 = run them automatically.
AGENT_AUTO_APPROVE=0

# pi coding agent (uses the local Ollama provider)
PI_PROVIDER=ollama
# Any model Ollama can serve, and it must be in ~/.pi/agent/models.json.
# Cloud models (name:cloud) need no download; /agentmodel registers models for you.
PI_MODEL=qwen3:8b
# off | minimal | low | medium | high | xhigh | max
PI_THINKING=high
PI_TOOLS=read,ls,find,grep,bash,edit,write
PI_TIMEOUT=900
# How long a tool approval stays pending before pi gives up on it.
PI_APPROVAL_TIMEOUT=900
# Localhost-only port the pi extension calls to ask for approval.
APPROVAL_PORT=8787
